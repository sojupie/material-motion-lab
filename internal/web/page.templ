package web

import "github.com/sojupie/tokens/forge/components/ui"

templ action(id string, label string, disabled bool) {
	@ui.Button(templ.Attributes{"id": id, "class": "md-button md-outlined-button", "disabled": disabled}) {
		{ label }
	}
}

templ videoPane(prefix string, label string) {
	<section id={ prefix + "-pane" } class="video-pane" aria-label={ label }>
		<h3 id={ prefix + "-name" }>{ label }</h3>
		<p id={ prefix + "-meta" } class="help"></p>
		<div class="image-wrap"><canvas id={ prefix + "-frame" } tabindex="0" aria-label={ label + " frame. Drag to select a tracking region." }></canvas></div>
		<div class="transport">
			@action(prefix+"-prev", "Previous", true)
			@action(prefix+"-play", "Play", true)
			@action(prefix+"-next", "Next", true)
		</div>
		<p id={ prefix + "-time" } class="time"></p>
		@ui.Slider(prefix+"-scrub", label+" frame")
		<div class="transport">
			@action(prefix+"-zero", "Set alignment here", true)
			@ui.Select(prefix+"-zoom", "Zoom", []ui.Option{{Value: "fit", Label: "Fit"}, {Value: "1", Label: "100%"}, {Value: "2", Label: "200%"}, {Value: "4", Label: "400%"}})
		</div>
		<p id={ prefix + "-quality" } class="help"></p>
		<div class="mark-controls">
			@ui.Select(prefix+"-marks", "Jump to", []ui.Option{{Value: "", Label: "Choose a mark"}})
			@action(prefix+"-weak-prev", "Previous weak match", true)
			@action(prefix+"-weak-next", "Next weak match", true)
		</div>
		<details class="tracking-controls">
			<summary>Tracking</summary>
			@ui.Select(prefix+"-method", "Method", []ui.Option{{Value: "feature", Label: "Image patch"}, {Value: "edge-x", Label: "Vertical edge (X)"}, {Value: "edge-y", Label: "Horizontal edge (Y)"}})
			<p id={ prefix + "-method-help" } class="help">Select a distinct detail on the first frame.</p>
			<div class="field-grid">
				<div>@ui.NumberField(prefix+"-start", "First frame", "0", "0", "")
@action(prefix+"-start-here", "Set first frame here", true)
</div>
				<div>@ui.NumberField(prefix+"-end", "Last frame", "0", "0", "")
@action(prefix+"-end-here", "Set last frame here", true)
</div>
				@ui.NumberField(prefix+"-search", "Search (px/frame)", "60", "4", "1000")
				@ui.NumberField(prefix+"-threshold", "Minimum score", "0.65", "0", "1")
			</div>
			<p id={ prefix + "-selection" } class="help">Draw a region on the first frame.</p>
			<div class="transport">@action(prefix+"-track", "Track interval", true)
@action(prefix+"-correct", "Correct here", true)
</div>
		</details>
		<details class="export-controls"><summary>Export</summary><div class="transport">@action(prefix+"-json", "Save JSON", true)
@action(prefix+"-csv", "Save CSV", true)
@action(prefix+"-export", "Export video", true)
</div></details>
	</section>
}

templ Page(entries []Entry) {
	<!DOCTYPE html>
	<html lang="en">
		<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>UI Motion</title><link rel="stylesheet" href="/assets/main.css"/><script type="module" src="/assets/main.js"></script>
</head>
		<body>
			<div id="app">
				<div class="shell">
					<aside class="desktop-navigation">
						@ui.Drawer("desktop-drawer", false, "Videos") {
							<h3>Videos</h3>
							<div id="projects" class="md-nav-items">
								for _,entry:=range entries {
									@ui.DrawerItem(templ.Attributes{"data-project-id": entry.ID, "aria-controls": "recording-content"}, entry.Name)
								}
							</div>
						}
					</aside>
					<main id="recording-content">
						<div class="workspace-actions">
							<div class="mobile-navigation" data-navigation-demo>
								@ui.DrawerToggle("recording-drawer", "Open videos")
								@ui.Drawer("recording-drawer", true, "Videos") {
									<div id="mobile-projects" class="md-nav-items">
										for _,entry:=range entries {
											@ui.DrawerItem(templ.Attributes{"data-project-id": entry.ID, "aria-controls": "recording-content"}, entry.Name)
										}
									</div>
								}
							</div>@action("import", "Open video", false)
							<input id="file" type="file" accept="video/*,.gif" hidden/>
						</div>
						<div id="status" role="status" aria-live="polite"></div>
						<section id="empty"><h2>Open a recording</h2><p>Track a detail or edge and inspect its movement frame by frame.</p>@action("empty-import", "Open video", false)
<p class="help">Videos and measurements stay on this machine.</p></section>
						<div id="workspace" class="workspace-container" hidden>
							<div class="comparison-controls">
								@ui.Select("reference", "Second video", []ui.Option{{Value: "", Label: "None"}})
								@action("align", "Align current frames", true)
								@ui.Checkbox("linked", "Linked playback")
								@action("play-both", "Play aligned", true)
							</div>
							<p id="alignment" class="help"></p>
							<div id="video-panes" class="video-panes">
								@videoPane("a", "First video")
								<div id="reference-pane" hidden>@videoPane("b", "Second video")
</div>
							</div>
							<section class="graph-panel" aria-label="Motion measurements">
								<h2>Position over time</h2>
								<div class="graph-controls">
									@ui.Select("axis", "Position", []ui.Option{{Value: "x", Label: "Horizontal"}, {Value: "y", Label: "Vertical"}})
									@ui.Select("units", "Units", []ui.Option{{Value: "px", Label: "Recording pixels"}, {Value: "progress", Label: "Progress (%)"}})
									@action("zoom-interval", "Zoom to intervals", true)
									@action("reset-zoom", "Full recording", true)
								</div>
								<p id="graph-note" class="help">Click to inspect. Drag across the graph to zoom.</p>
								<div class="graph-wrap"><svg id="graph" viewBox="0 0 1000 300" role="img" aria-label="Tracked displacement against time" tabindex="0"></svg></div>
								<div id="legend" class="legend"><span>First video</span><span class="ref" id="ref-legend" hidden>Second video</span><span class="expected" id="curve-legend" hidden>Reference curve</span></div>
								<div class="reference-controls">
									@ui.Select("curve", "Reference curve", []ui.Option{{Value: "none", Label: "None"}, {Value: "md3", Label: "MD3 standard"}, {Value: "linear", Label: "Linear"}})
									@ui.NumberField("duration", "Reference duration (ms)", "300", "1", "60000")
									@action("fit-a", "Fit duration to first", true)
									@action("fit-b", "Fit duration to second", true)
								</div>
								<p id="curve-note" class="help" hidden>Reference curves start at each alignment frame and use its selected last frame as the target position.</p>
								<div class="measurement-results"><p id="a-result" class="help"></p><p id="b-result" class="help" hidden></p></div>
							</section>
						</div>
						<footer>Coordinates use recording pixels. Times use the original video frame timestamps.</footer>
					</main>
				</div>
				<template id="recording-item-template">@ui.DrawerItem(templ.Attributes{"data-project-id": "", "aria-controls": "recording-content"}, "")
</template>
				<template id="field-option-template">@ui.SelectOption("", "", "", false)
</template>
			</div>
		</body>
	</html>
}
