package web

import "github.com/sojupie/tokens/forge/components/ui"
import "github.com/sojupie/ui-motion/internal/analysis"

func referenceOptions() []ui.Option {
	result := []ui.Option{{Value: "none", Label: "None"}}
	for _, ref := range analysis.ReferencePresets() {
		result = append(result, ui.Option{Value: ref.ID, Label: ref.Label})
	}
	return append(result, ui.Option{Value: "custom-bezier", Label: "Custom Bézier"}, ui.Option{Value: "custom-spring", Label: "Custom spring"})
}

templ action(id string, label string, disabled bool) {
	@ui.Button(templ.Attributes{"id": id, "class": "md-button md-text-button", "disabled": disabled}) {
		{ label }
	}
}

templ iconAction(id string, label string, path string) {
	@ui.Button(templ.Attributes{"id": id, "class": "md-icon-button md-standard-icon-button", "data-size": "small", "data-shape": "round", "data-width": "default", "aria-label": label, "title": label, "disabled": true}) {
		<svg viewBox="0 -960 960 960" width="24" height="24" fill="currentColor" aria-hidden="true"><path d={ path }></path></svg>
	}
}

templ videoPane(prefix string, label string) {
	<section id={ prefix + "-pane" } class="video-pane" aria-label={ label }>
		<div class="viewer-toolbar">
			@ui.Button(templ.Attributes{"id": prefix + "-select", "class": "md-button md-text-button viewer-title", "aria-current": "false"}) {
				<span id={ prefix + "-name" }>{ label }</span>
			}
			@ui.Select(prefix+"-zoom", "Viewer zoom", []ui.Option{{Value: "fit", Label: "Fit"}, {Value: "1", Label: "100%"}, {Value: "2", Label: "200%"}, {Value: "4", Label: "400%"}})
		</div>
		<p id={ prefix + "-meta" } class="help"></p>
		<div class="image-wrap"><canvas id={ prefix + "-frame" } tabindex="0" aria-label={ label + " frame" }></canvas></div>
		<div class="viewer-status"><p id={ prefix + "-time" } class="time"></p><p id={ prefix + "-quality" } class="help"></p></div>
	</section>
}

templ trackingInspector(prefix string) {
	<div id={ prefix + "-inspector" } hidden>
		<section aria-label="Tracking range">
			<h3>Tracking range</h3>
			<div class="field-grid">
				@ui.NumberField(prefix+"-start", "First frame", "0", "0", "")
				@ui.NumberField(prefix+"-end", "Last frame", "0", "0", "")
			</div>
			<div class="inspector-actions">
				@action(prefix+"-start-here", "Set start", true)
				@action(prefix+"-end-here", "Set end", true)
				@action(prefix+"-goto-start", "Go to start", true)
				@action(prefix+"-goto-end", "Go to end", true)
			</div>
		</section>
		<section aria-label="Tracking settings">
			<h3>Tracking</h3>
			@ui.Select(prefix+"-method", "Method", []ui.Option{{Value: "feature", Label: "Image patch"}, {Value: "edge-x", Label: "Vertical edge (X)"}, {Value: "edge-y", Label: "Horizontal edge (Y)"}, {Value: "width", Label: "Width (opposing edges)"}, {Value: "height", Label: "Height (opposing edges)"}})
			<p id={ prefix + "-method-help" } class="help"></p>
			@action(prefix+"-draw", "Draw tracking region", true)
			<p id={ prefix + "-selection" } class="help"></p>
			<div class="field-grid">
				@ui.NumberField(prefix+"-search", "Search (px/frame)", "60", "4", "1000")
				@ui.NumberField(prefix+"-threshold", "Minimum score", "0.65", "0", "1")
			</div>
			<p id={ prefix + "-dirty" } class="help"></p>
			<div class="inspector-actions">
				@ui.Button(templ.Attributes{"id": prefix + "-track", "class": "md-button md-filled-button", "disabled": true}) {
					Track selected range
				}
				@action(prefix+"-correct", "Set tracking position at playhead", true)
			</div>
		</section>
		<section aria-label="Tracking marks" id={ prefix + "-marks" }>
			<p id={ prefix + "-marks-empty" } class="help">No corrections or tracking losses.</p>
			<h3>Tracking marks</h3>
			<div class="inspector-actions">
				@action(prefix+"-anchor-prev", "Previous correction", true)
				@action(prefix+"-anchor-next", "Next correction", true)
				@action(prefix+"-weak-prev", "Previous tracking loss", true)
				@action(prefix+"-weak-next", "Next tracking loss", true)
			</div>
		</section>
	</div>
}

templ exportSettings(prefix string) {
	<div id={ prefix + "-export-panel" } hidden>
		<img id={ prefix + "-export-preview" } class="export-preview" alt="Annotated export preview"/>
		<p id={ prefix + "-export-summary" } class="help"></p>
		<section class="export-controls" aria-label="Export">
			<div class="field-grid">
				@ui.NumberField(prefix+"-export-first", "First frame", "0", "0", "")
				@ui.NumberField(prefix+"-export-last", "Last frame", "0", "0", "")
			</div>
			<div class="inspector-actions">
				@action(prefix+"-export-range-tracking", "Tracking range", true)
				@action(prefix+"-export-range-playback", "Playback range", true)
				@action(prefix+"-export-range-full", "Full video", true)
			</div>
			<div class="field-grid">
				@ui.NumberField(prefix+"-export-speed", "Speed", "1", "0.125", "4")
				@ui.NumberField(prefix+"-export-repeat", "Repetitions", "1", "1", "10")
			</div>
			<div class="export-options">
				@ui.Checkbox(prefix+"-export-tracking", "Tracking outlines")
				@ui.Checkbox(prefix+"-export-plot", "Displacement chart")
				@ui.Checkbox(prefix+"-export-reference", "Reference curve")
				@ui.Checkbox(prefix+"-export-statistics", "Measurement results")
				@ui.Checkbox(prefix+"-export-markers", "Corrections and tracking loss")
				@ui.Checkbox(prefix+"-export-time", "Frame and source time")
				@ui.Checkbox(prefix+"-export-comparison", "Include second video")
				@ui.Checkbox(prefix+"-export-view", "Use current chart window and scale")
			</div>
		</section>
	</div>
}

templ tool(id string, label string, path string) {
	@ui.Button(templ.Attributes{"id": id, "class": "md-icon-button md-standard-icon-button", "data-size": "small", "data-shape": "round", "data-width": "default", "aria-label": label, "title": label}) {
		<svg viewBox="0 -960 960 960" width="24" height="24" fill="currentColor" aria-hidden="true"><path d={ path }></path></svg>
	}
}

func transportClass(primary bool) string {
	if primary {
		return "md-button md-filled-button"
	}
	return "md-icon-button md-tonal-icon-button"
}

templ transportButton(id string, label string, path string, primary bool) {
	@ui.Button(templ.Attributes{"id": id, "class": transportClass(primary), "data-size": "small", "data-shape": "round", "data-width": "default", "data-group-button": id, "aria-label": label, "title": label, "disabled": true}) {
		<svg viewBox="0 -960 960 960" width="24" height="24" fill="currentColor" aria-hidden="true"><path d={ path }></path></svg>
 if primary {
 <span data-transport-label>Play</span>
 }
	}
}

templ splitter(id string, label string, orientation string) {
	<div id={ id } class="pane-splitter" role="separator" tabindex="0" aria-label={ label } aria-orientation={ orientation } aria-valuemin="0" aria-valuemax="100" aria-valuenow="50" title={ label + ". Drag or use arrow keys. Enter collapses or restores." }></div>
}

templ Page(entries []Entry) {
	<!DOCTYPE html>
	<html lang="en">
		<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>UI Motion</title><link rel="stylesheet" href="/assets/main.css"/><script type="module" src="/assets/main.js"></script>
</head>
		<body>
			<div id="app">
				<header class="application-bar">
					<div class="md-toolbar" data-variant="docked" data-control="standard" data-orientation="horizontal" role="toolbar" aria-label="Workspace actions">
						@tool("toggle-media", "Show videos", "M120-240v-480h720v480H120Zm80-80h160v-320H200v320Zm240 0h320v-320H440v320Z")
						@action("import", "Open video", false)
						<span class="app-name">UI Motion</span>
						<span id="save-state" class="help" role="status"></span>
						<div class="layout-menu-wrap" data-menu-example>
							@ui.Button(templ.Attributes{"class": "md-button md-text-button", "data-menu-open": "layout-menu", "aria-controls": "layout-menu", "aria-expanded": "false", "aria-haspopup": "menu"}) {
								Layout
							}
							<output data-menu-output class="visually-hidden"></output><div id="layout-menu" class="md-menu layout-menu" data-variant="standard" data-orientation="vertical" popover="auto" data-menu-panel data-menu-main role="menu" aria-label="Layout">
								<ul><li><button type="button" id="focus-viewer" class="md-menu-item" role="menuitem" data-menu-action>Maximize viewer</button></li><li><button type="button" id="focus-chart" class="md-menu-item" role="menuitem" data-menu-action>Maximize chart</button></li><li><button type="button" id="restore-layout" class="md-menu-item" role="menuitem" data-menu-action>Restore workspace</button></li><li><hr class="md-divider"/></li><li><button type="button" id="reset-layout" class="md-menu-item" role="menuitem" data-menu-action>Reset layout</button></li></ul>
							</div>
						</div>
						@tool("toggle-inspector", "Show tools", "M120-120v-720h720v720H120Zm80-80h360v-560H200v560Zm440 0h120v-560H640v560Z")
						@ui.Button(templ.Attributes{"id": "open-export", "class": "md-button md-filled-button", "disabled": true, "aria-haspopup": "dialog", "aria-controls": "export-dialog"}) {
							Export
						}
					</div>
					<input id="file" type="file" accept="video/*,.gif" hidden/>
				</header>
				<div id="status" role="status" aria-live="polite"></div>
				<div class="shell">
					<dialog id="media-panel" class="md-sheet md-side-sheet media-panel" data-control="docked" aria-label="Videos">
						<header class="panel-heading"><h2>Videos</h2>@tool("close-media", "Hide videos", "M256-200 200-256l224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z")
</header>
						<nav id="projects" class="md-navigation md-navigation-drawer" data-variant="standard" data-navigation-group aria-label="Recordings">
							for _,entry:=range entries {
								@ui.DrawerItem(templ.Attributes{"data-project-id": entry.ID, "aria-controls": "recording-content"}, entry.Name)
							}
						</nav>
					</dialog>
					@splitter("media-splitter", "Resize videos panel", "vertical")
					<main id="recording-content">
						<section id="empty"><h1>Open a recording</h1><p>Track a detail or edge and inspect its movement frame by frame.</p>@ui.Button(templ.Attributes{"id": "empty-import", "class": "md-button md-filled-button"}) {
	Open video
}
<p class="help">Videos and measurements stay on this machine.</p></section>
						<div id="workspace" class="workspace-container" hidden>
							<div class="editing-main">
								<section id="viewer-area" aria-label="Video viewers">
									<div class="workspace-toolbar">@ui.Select("reference", "Second video", []ui.Option{{Value: "", Label: "None"}})
<div class="viewer-actions">@action("open-tracking", "Tracking settings", false)
@action("open-alignment", "Alignment", true)
@tool("maximize-viewer", "Maximize or restore viewer", "M120-120v-240h80v160h160v80H120Zm480 0v-80h160v-160h80v240H600ZM120-600v-240h240v80H200v160h-80Zm640 0v-160H600v-80h240v240h-80Z")
</div></div>
									<div id="video-panes" class="video-panes">@videoPane("a", "Video A")
<div id="reference-pane" hidden>@videoPane("b", "Video B")
</div></div>
								</section>
								@splitter("viewer-splitter", "Resize viewer and chart", "horizontal")
								<section class="timeline-panel" aria-label="Workspace timeline" data-menu-example>
									<div class="timeline-header">
										<div class="transport">
											<div class="md-button-group" data-control="standard" data-size="small" role="group" aria-label="Playback controls">
												@transportButton("previous-frame", "Previous frame", "M240-240v-480h80v480h-80Zm480 0L360-480l360-240v480Z", false)
												@transportButton("play", "Play", "M320-200v-560l440 280-440 280Z", true)
												@transportButton("next-frame", "Next frame", "M240-240v-480l360 240-360 240Zm400 0v-480h80v480h-80Z", false)
											</div><output id="playhead-time"></output>
											@ui.Select("playback-speed", "Speed", []ui.Option{{Value: "0.125", Label: "⅛×"}, {Value: "0.25", Label: "¼×"}, {Value: "0.5", Label: "½×"}, {Value: "1", Label: "1×"}, {Value: "2", Label: "2×"}, {Value: "4", Label: "4×"}})
											@ui.Checkbox("playback-loop", "Loop")
											@ui.Button(templ.Attributes{"class": "md-button md-text-button", "aria-label": "Playback interval", "data-menu-open": "playback-menu", "aria-controls": "playback-menu", "aria-expanded": "false", "aria-haspopup": "menu"}) {
												<output id="playback-range"></output>
											}
										</div>
										<div class="timeline-tools">@iconAction("timeline-out", "Zoom out timeline", "M200-440v-80h560v80H200Z")
@iconAction("timeline-in", "Zoom in timeline", "M440-440H200v-80h240v-240h80v240h240v80H520v240h-80v-240Z")
@action("timeline-fit", "Fit clips", true)
@action("timeline-range", "Fit range", true)
</div>
									</div>
									<output data-menu-output class="visually-hidden"></output><div id="playback-menu" class="md-menu playback-menu" data-variant="standard" data-orientation="vertical" popover="auto" data-menu-panel data-menu-main role="menu" aria-label="Playback interval">
										<ul><li><button type="button" class="md-menu-item" role="menuitem" data-menu-action id="playback-start">Set start at playhead</button></li><li><button type="button" class="md-menu-item" role="menuitem" data-menu-action id="playback-end">Set end at playhead</button></li><li><button type="button" class="md-menu-item" role="menuitem" data-menu-action id="playback-reset">Full clips</button></li></ul>
									</div>
									<p class="visually-hidden" id="timeline-help">Drag the ruler to scrub frame by frame. Drag playback handles to limit playback. Drag a clip to move it. Drag range handles to choose which frames to track.</p>
									<svg id="timeline" role="group" aria-describedby="timeline-help" aria-label="Video tracks and time ruler" viewBox="0 0 900 200"></svg>
									<div id="timeline-pan" class="timeline-pan" tabindex="0" role="region" aria-label="Timeline horizontal scroll"><div></div></div>
								</section>
								<section id="chart-area" class="graph-panel" aria-label="Displacement measurements">
									<div class="chart-toolbar">
										<h2>Displacement</h2>
										<span id="chart-measurement-summary" class="help"></span>
										@ui.Button(templ.Attributes{"id": "open-reference", "class": "md-button md-tonal-button", "aria-controls": "reference-settings"}) {
											Chart settings
										}
										<span id="reference-summary" class="help" hidden></span>
										@tool("maximize-chart", "Maximize or restore chart", "M120-120v-240h80v160h160v80H120Zm480 0v-80h160v-160h80v240H600ZM120-600v-240h240v80H200v160h-80Zm640 0v-160H600v-80h240v240h-80Z")
									</div>
									<p id="graph-note" class="visually-hidden">Click a sample to inspect its frame. Enable Pan plot to move the chart.</p>
									<div class="graph-readouts">
										<div>
											<output id="sample-info" class="sample-info help" aria-live="polite"></output>
											<div id="legend" class="legend"><span>Video A</span><span class="ref" id="ref-legend" hidden>Video B</span><span class="expected" id="curve-legend" hidden>Reference curve</span></div>
											<p id="curve-note" class="help" hidden>Reference curves run from each tracking range’s first position to its last position.</p>
										</div>
										<div class="measurement-results"><p id="a-result" class="help"></p><p id="b-result" class="help" hidden></p></div>
									</div>
									<div class="graph-wrap"><svg id="graph" viewBox="0 0 900 400" role="group" aria-label="Tracked displacement against workspace time. Use arrow keys to inspect frames." aria-describedby="sample-info" tabindex="0"></svg></div>
								</section>
							</div>
						</div>
					</main>
					@splitter("inspector-splitter", "Resize tools panel", "vertical")
					<dialog id="inspector" class="md-sheet md-side-sheet inspector" data-control="docked" aria-labelledby="inspector-title">
						<div class="md-sheet-content">
							<header class="md-sheet-header"><h2 id="inspector-title" class="md-sheet-title">Video A</h2>@tool("close-inspector", "Hide tools", "M256-200 200-256l224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z")
</header>
							<div class="inspector-tabs md-button-group" data-control="connected" data-shape="single" data-size="small" role="group" aria-label="Inspector section">
								for _,mode:=range []ui.Option{{Value:"tracking",Label:"Tracking"},{Value:"alignment",Label:"Alignment"},{Value:"reference",Label:"Chart"}} {
									@ui.Button(templ.Attributes{"id": "inspect-" + mode.Value, "class": "md-button md-tonal-button", "data-size": "small", "data-group-button": mode.Value, "data-button-toggle": "", "aria-pressed": mode.Value == "tracking", "aria-controls": mode.Value + "-settings"}) {
										{ mode.Label }
									}
								}
							</div>
							<div class="md-sheet-body">
								<div id="tracking-settings">@trackingInspector("a")
@trackingInspector("b")
</div>
								<div id="alignment-settings" hidden>
									<section class="alignment-controls" aria-label="Clip alignment">
										<h3>Alignment</h3>
										<div class="inspector-actions">
											@action("mark-sync", "Mark sync point", true)
											@action("goto-sync", "Go to sync point", true)
											@action("align-sync", "Align sync points", true)
										</div>
										<p id="sync-info" class="help"></p>
										@ui.NumberField("clip-offset", "Clip offset (ms)", "0", "-86400000", "86400000")
										<div class="inspector-actions">
											@action("nudge-earlier", "Move one frame earlier", true)
											@action("nudge-later", "Move one frame later", true)
										</div>
									</section>
								</div>
								<div id="reference-settings" hidden>
									<h3>Chart display</h3>
									<div class="chart-controls">@ui.Select("axis", "Position", []ui.Option{{Value: "x", Label: "Horizontal"}, {Value: "y", Label: "Vertical"}, {Value: "width", Label: "Width"}, {Value: "height", Label: "Height"}})
@ui.Select("units", "Units", []ui.Option{{Value: "px", Label: "Pixels"}, {Value: "progress", Label: "Progress (%)"}})
</div>
									<div class="graph-scale-controls" role="group" aria-label="Vertical axis">
										@ui.Checkbox("graph-pan", "Pan plot")
										@action("graph-fit", "Fit motion", true)
										@iconAction("graph-zoom-out", "Zoom out vertical axis", "M200-440v-80h560v80H200Z")
										@iconAction("graph-zoom-in", "Zoom in vertical axis", "M440-440H200v-80h240v-240h80v240h240v80H520v240h-80v-240Z")
										@action("graph-fit-end", "Fit end position", true)
										<output id="graph-scale-info"></output>
									</div>
									<h3>Reference curve</h3>@ui.Select("curve", "Reference curve", referenceOptions())
									<p id="no-reference" class="help">Choose a reference to compare with the measured motion.</p>
									<section id="reference-controls" class="reference-editor" hidden aria-label="Reference parameters">
										<div id="bezier-controls" class="reference-controls">
											@ui.NumberField("bezier-x1", "X1", "0.2", "0", "1")
											@ui.NumberField("bezier-y1", "Y1", "0", "-10", "10")
											@ui.NumberField("bezier-x2", "X2", "0", "0", "1")
											@ui.NumberField("bezier-y2", "Y2", "1", "-10", "10")
										</div>
										<div id="spring-controls" class="reference-controls" hidden>
											@ui.NumberField("spring-stiffness", "Stiffness (mass 1)", "380", "0.001", "1000000")
											@ui.NumberField("spring-damping", "Damping ratio", "0.8", "0", "100")
											@ui.NumberField("spring-velocity", "Initial velocity (travel/s)", "0", "-1000", "1000")
										</div>
										<div id="duration-controls" class="reference-controls">
											@ui.NumberField("duration", "Reference duration (ms)", "300", "1", "60000")
											@action("fit-a", "Fit duration to A", true)
											@action("fit-b", "Fit duration to B", true)
										</div>
										<p id="spring-note" class="help" hidden>Springs use elapsed time. Initial velocity is measured in total travel distances per second.</p>
										<p class="help"><a id="reference-source" target="_blank" rel="noopener" hidden>Reference definition</a></p>
										<div class="inspector-actions">
											@action("reference-save", "Save reference", false)
											@action("reference-load", "Load reference", false)
											<input id="reference-file" type="file" accept="application/json,.json" hidden/>
										</div>
										<p id="reference-status" class="help" role="status"></p>
									</section>
								</div>
							</div>
						</div>
					</dialog>
				</div>
				<dialog id="export-dialog" class="md-dialog export-dialog" data-variant="basic" data-dialog-surface aria-labelledby="export-title">
					<header class="md-basic-header"><h2 id="export-title">Export</h2><p id="export-name" class="help"></p></header>
					<div class="md-dialog-content">
						<div class="export-format">@ui.Select("export-source", "Video", []ui.Option{{Value: "a", Label: "Video A"}, {Value: "b", Label: "Video B"}})
@ui.Select("export-format", "Format", []ui.Option{{Value: "video", Label: "Annotated video"}, {Value: "chart", Label: "Chart SVG"}, {Value: "json", Label: "Tracking JSON"}, {Value: "csv", Label: "Measurements CSV"}})
</div>
						@exportSettings("a")
						@exportSettings("b")
						<p id="export-error" class="error" role="alert"></p>
						<p id="export-status" role="status"></p>
					</div>
					<footer class="md-basic-actions">@ui.Button(templ.Attributes{"id": "export-close", "class": "md-button md-text-button"}) {
	Cancel
}
@ui.Button(templ.Attributes{"id": "export-run", "class": "md-button md-filled-button"}) {
	Export
}
</footer>
				</dialog>
				<template id="recording-item-template">@ui.DrawerItem(templ.Attributes{"data-project-id": "", "aria-controls": "recording-content"}, "")
</template>
				<template id="field-option-template">@ui.SelectOption("", "", "", false)
</template>
			</div>
		</body>
	</html>
}
