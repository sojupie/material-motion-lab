{
  "name": "ui-motion",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run lint && tsc --noEmit && vite build && node scripts/browser-assets.mjs",
    "test": "node --test tests/*.test.mjs",
    "generate": "go run github.com/a-h/templ/cmd/templ@v0.3.960 generate -path internal/web",
    "lint": "oxlint --type-aware --type-check web vite.config.ts"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "fake-indexeddb": "^6.2.6",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "postcss": "^8.5.31",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@techstark/opencv-js": "4.12.0-release.1",
    "fflate": "^0.8.3"
  }
}
